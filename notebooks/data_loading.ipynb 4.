      "source": [
        "# Check functional MRI files for all participants\n",
        "file_results = []\n",
        "\n",
        "for participant_id in participants[\"participant_id\"]:\n",
        "\n",
        "    file_path = (\n",
        "        f\"{S3_ROOT}/{participant_id}/func/\"\n",
        "        f\"{participant_id}_task-rest_bold.nii.gz\"\n",
        "    )\n",
        "\n",
        "    result = subprocess.run(\n",
        "        [\"aws\", \"s3\", \"ls\", file_path, \"--no-sign-request\"],\n",
        "        capture_output=True,\n",
        "        text=True\n",
        "    )\n",
        "\n",
        "    if result.returncode == 0 and result.stdout.strip():\n",
        "        file_info = result.stdout.strip().split()\n",
        "        file_size = int(file_info[2])\n",
        "\n",
        "        file_results.append({\n",
        "            \"participant_id\": participant_id,\n",
        "            \"bold_file_available\": True,\n",
        "            \"file_size_MB\": round(file_size / (1024 ** 2), 2)\n",
        "        })\n",
        "    else:\n",
        "        file_results.append({\n",
        "            \"participant_id\": participant_id,\n",
        "            \"bold_file_available\": False,\n",
        "            \"file_size_MB\": None\n",
        "        })\n",
        "\n",
        "bold_inventory = pd.DataFrame(file_results)\n",
        "\n",
        "display(bold_inventory)\n",
        "\n",
        "print(\"Total participants:\", len(bold_inventory))\n",
        "print(\"Available BOLD files:\", bold_inventory[\"bold_file_available\"].sum())\n",
        "print(\"Missing BOLD files:\", (~bold_inventory[\"bold_file_available\"]).sum())"
      ],
