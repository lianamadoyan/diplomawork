        "import os\n",
        "import glob\n",
        "import json\n",
        "import subprocess\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import nibabel as nib\n",
        "import networkx as nx\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats\n",
        "from packaging.version import Version\n",
        "\n",
        "import nilearn\n",
        "from nilearn import datasets, image, plotting\n",
        "from nilearn.image import mean_img\n",
        "from nilearn.maskers import NiftiLabelsMasker\n",
        "from nilearn.signal import clean\n",
        "\n",
        "# clean(..., sample_mask=...) with band-pass needs interpolation of censored volumes (nilearn >= 0.10)\n",
        "assert Version(nilearn.__version__) >= Version(\"0.10.0\"), f\"nilearn {nilearn.__version__} is too old, need >= 0.10.0\""
      ],
      "id": "cell002"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "cell003"
      },
      "execution_count": 21,
      "outputs": [],
      "source": [
        "# Colab -> /content, otherwise a local ./data folder\n",
        "DATA_DIR = \"/content\" if os.path.exists(\"/content\") else os.path.abspath(\"data\")\n",
        "os.makedirs(DATA_DIR, exist_ok=True)\n",
        "\n",
        "S3_ROOT = \"s3://openneuro.org/ds005892\"\n",
        "SUBJECT = \"sub-MJF001\"   # used only for the single-subject exploration of raw data (sections 3-4)\n",
        "FMAP_NAMES = [\"magnitude1\", \"magnitude2\", \"phasediff\"]\n",
        "\n",
        "N_DUMMY = 0   # only for the raw-data exploration in section 4; the FC pipeline censors fMRIPrep non-steady-state volumes automatically\n",
        "\n",
        "# fMRIPrep output folder (the folder that contains sub-*/), see section 5\n",
        "PREP_DIR = f\"{DATA_DIR}/derivatives/fmriprep\"\n",
        "OUT_DIR = f\"{DATA_DIR}/fc_results\"\n",
        "os.makedirs(f\"{OUT_DIR}/fc\", exist_ok=True)\n",
        "\n",
        "# ---- quality control ----\n",
        "FD_THRESH = 0.5          # volumes with FD above this (mm) are censored (scrubbed)\n",
        "MAX_MEAN_FD = 0.5        # participants with higher mean FD are excluded\n",
        "MIN_KEPT_SECONDS = 240   # participants with less than 4 min of usable data are excluded\n",
        "\n",
        "# ---- graph analysis ----\n",
        "DENSITIES = [0.10, 0.15, 0.20, 0.25, 0.30]   # fraction of strongest positive edges kept (same density for every participant)\n",
        "HUB_DENSITY = 0.15                           # density used for nodal degree / hub analysis\n",
        "N_NULL = 20                                  # random graphs per participant/density for small-world sigma\n",
        "N_PERM = 5000                                # permutations for group tests\n",
        "SEED = 42\n",
        "\n",
        "\n",
        "def aws(args, tail=None):\n",
        "    \"\"\"Run `aws s3 <args> --no-sign-request` and print its output.\"\"\"\n",
        "    result = subprocess.run(\n",
        "        [\"aws\", \"s3\"] + args.split() + [\"--no-sign-request\"],\n",
        "        capture_output=True, text=True\n",
        "    )\n",
        "    out = (result.stdout + result.stderr).strip()\n",
        "    if tail:\n",
        "        out = \"\\n\".join(out.splitlines()[-tail:])\n",
        "    if out:\n",
        "        print(out)\n",
        "    if result.returncode != 0:\n",
        "        raise RuntimeError(f\"aws s3 {args} failed (code {result.returncode})\")\n",
        "    return result"
      ],
      "id": "cell003"
    },
