      "source": [
        "# Download and load the participants table\n",
        "aws(f\"cp {S3_ROOT}/participants.tsv {DATA_DIR}/participants.tsv\")\n",
        "participants = pd.read_csv(f\"{DATA_DIR}/participants.tsv\", sep=\"\\t\")\n",
        "\n",
        "print(\"Dataset dimensions (participants, columns):\", participants.shape)\n",
        "\n",
        "print(\"\\nColumn names:\")\n",
        "print(participants.columns.tolist())\n",
        "\n",
        "print(\"\\nParticipants data:\")\n",
        "display(participants)\n",
        "\n",
        "# Count unique values in categorical columns\n",
        "print(\"\\nCategorical variable distributions:\")\n",
        "for col in participants.select_dtypes(include=[\"object\", \"string\"]).columns:\n",
        "    print(f\"\\n{col}:\")\n",
        "    print(participants[col].value_counts(dropna=False))\n",
        "\n",
        "print(\"Missing values:\")\n",
        "print(participants.isnull().sum())\n",
        "\n",
        "# Age statistics by group\n",
        "print(\"\\nAge statistics by group:\")\n",
        "display(\n",
        "    participants.groupby(\"group\")[\"age\"].agg(\n",
        "        [\"count\", \"mean\", \"std\", \"min\", \"max\"]\n",
        "    ).round(2)\n",
        ")\n",
        "\n",
        "# Sex distribution by group\n",
        "print(\"\\nSex distribution by group:\")\n",
        "display(\n",
        "    pd.crosstab(\n",
        "        participants[\"group\"],\n",
        "        participants[\"sex\"],\n",
        "        margins=True\n",
        "    )\n",
        ")\n",
        "\n",
        "# Make sure every group value is mapped (otherwise it silently stays as it is)\n",
        "unmapped = set(participants[\"group\"].dropna().unique()) - {\"PD-NC\", \"PD-MCI\", \"Control\"}\n",
        "assert not unmapped, f\"Unmapped group values: {unmapped}\"\n",
        "\n",
        "# Create a binary diagnostic group\n",
        "participants[\"diagnosis\"] = participants[\"group\"].replace({\n",
        "    \"PD-NC\": \"PD\",\n",
        "    \"PD-MCI\": \"PD\",\n",
        "    \"Control\": \"Control\"\n",
        "})\n",
        "\n",
        "print(\"\\nDiagnostic group distribution:\")\n",
        "print(participants[\"diagnosis\"].value_counts())"
      ],
